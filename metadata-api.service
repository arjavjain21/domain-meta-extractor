[Unit]
Description=Metadata Extractor API Service
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/metadata_extractor/backend
Environment="PATH=/home/ubuntu/projects/metadata_extractor/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/ubuntu/projects/metadata_extractor/backend/.env.production
ExecStart=/home/ubuntu/projects/metadata_extractor/backend/venv/bin/python3 /home/ubuntu/projects/metadata_extractor/backend/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=metadata-api

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
